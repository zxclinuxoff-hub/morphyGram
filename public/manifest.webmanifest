{
  "name": "MorphyGram",
  "short_name": "MorphyGram",
  "description": "Тёмный веб-клиент Telegram с памятью на удалённые сообщения",
  "lang": "ru",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#070708",
